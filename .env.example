# Enables the AI check on video screenshots (optional)
ANTHROPIC_API_KEY=

# Switch to 1 only if your company accepts downloading videos from YouTube (breaks YouTube's terms)
# ALLOW_YOUTUBE_DOWNLOAD=0

# Time of the automatic daily scrape
# RUN_AT=07:00
